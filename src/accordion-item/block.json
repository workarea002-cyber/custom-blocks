{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "custom-blocks/accordion-item",
	"version": "0.1.0",
	"title": "Accordion Item",
	"parent": ["custom-blocks/accordion"],
	"category": "widgets",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"attributes": {
		"headingTextAlign": {
			"type": "string"
		},
		"headingContent": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": ".heading"
		},
		"headTag": {
			"type": "string",
			"default": ""
		},
		"accordionIcon": {
			"type": "object",
			"default": {
				"openUrl": "",
				"closeUrl": ""
			}
		},
		"iconType": {
			"type": "string",
			"default": ""
		},
		"iconColor": {
			"type": "object",
			"default": {
				"fill": "",
				"stroke": ""
			}
		}
	},
	"allowedBlocks": ["core/paragraph", "core/image", "core/list"],
	"supports": {
		"__experimentalSlashInserter": true,
		"inserter": true,
		"contentRole": true
	},
	"usesContext": [
		"defaultAccordionIcons",
		"customAccordionIcons",
		"iconType",
		"headingTag",
		"iconColor"
	],
	"textdomain": "my-custom-blocks",
	"editorScript": "file:./index.js"
}

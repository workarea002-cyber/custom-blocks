{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "custom-blocks/accordion",
	"version": "1.0.1",
	"title": "Accordion",
	"category": "widgets",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"allowedBlocks": ["custom-blocks/accordion-item"],
	"attributes": {
		"fontSize": {
			"type": "object",
			"default": {
				"heading": "22px",
				"content": "16px"
			}
		},
		"headingTag": {
			"type": "string",
			"default": "h3"
		},
		"textColor": {
			"type": "object",
			"default": {
				"headingColor": "",
				"activeHeadingColor": "",
				"contentColor": ""
			}
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"bgColor": "",
				"activeBgColor": "",
				"headerBgColor": "",
				"contentBgColor": ""
			}
		},
		"headerPadding": {
			"type": "object",
			"default": {
				"top": "16px",
				"right": "16px",
				"bottom": "16px",
				"left": "16px"
			}
		},
		"contentPadding": {
			"type": "object",
			"default": {
				"top": "16px",
				"right": "16px",
				"bottom": "16px",
				"left": "16px"
			}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"top": "8px",
				"right": "8px",
				"bottom": "8px",
				"left": "8px"
			}
		},
		"gap": {
			"type": "string",
			"default": "24px"
		},
		"contentSpacing": {
			"type": "string",
			"default": "8px"
		},
		"customAccordionIcons": {
			"type": "object",
			"default": {
				"openId": 0,
				"closeId": 0,
				"openUrl": "",
				"closeUrl": ""
			}
		},
		"defaultAccordionIcons": {
			"type": "object",
			"default": {
				"openId": 2,
				"closeId": 7
			}
		},
		"iconType": {
			"type": "string",
			"default": "default"
		},
		"iconColor": {
			"type": "string",
			"default": "#000000"
		},
		"multiple": {
			"type": "boolean",
			"default": true
		}
	},
	"providesContext": {
		"headingTag": "headingTag",
		"defaultAccordionIcons": "defaultAccordionIcons",
		"customAccordionIcons": "customAccordionIcons",
		"iconType": "iconType",
		"iconColor": "iconColor"
	},
	"supports": {
		"html": false,
		"border": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": ["px", "em", "rem", "vh", "vw"],
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		},
		"inserter": true
	},
	"textdomain": "my-custom-blocks",
	"editorStyle": "file:./index.css",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:../render.php"
}
